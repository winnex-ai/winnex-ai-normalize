{
  "__meta__": "Winnex AI Normalize — Default Dataset Preset (agnostic)",
  "version": "1.1.1",
  "dataset": "default",
  "description": "Preset agnóstico: o QualityValidator decide a config pela prova do próprio motor (pruned_by_bound/N). Não força basis nem knobs de busca — o roteador é o gate. Apenas os fixes universais de segurança (pca_iterations=30 para acelerar o build PCA, early_exit=false para não degradar recall em dim ≥ 384) são default. Usado quando o operador não especifica um preset de dataset.",

  "engine": {
    "basis": null,
    "metric": "cosine",
    "quant": null,
    "stage1_dim": null,
    "stage2_dim": null,
    "k1_fraction": null,
    "k2_fraction": null,
    "k2_max": 2000,
    "early_exit": false,
    "postfilter": true,
    "normalize_input": true,
    "pca_iterations": 30,
    "seed": 42
  },

  "quality": {
    "probe_pca": true,
    "n_seed_queries": 8,
    "k": 10,
    "fold_bound_frac": 0.50,
    "fold_bound_frac_low": 0.20,
    "resolution_gap_warn": 0.10,
    "fail_on_resolution": false,
    "nan_policy": "block_pca",
    "nan_blocked_route": { "basis": "random", "k1_fraction": 0.20 },
    "recall_floor": 0.95,
    "stage1_probe_random": 64,
    "stage1_probe_pca": 192,
    "probe_pca_dim_gate": 64,
    "route_rules": [
      {
        "when": { "bound_fraction": ">= 0.50" },
        "route": { "basis": "pca_corpus", "k1_fraction": 0.05 }
      },
      {
        "when": { "bound_fraction": ">= 0.20" },
        "route": { "basis": "random", "k1_fraction": 0.10 }
      },
      {
        "when": {
          "bound_fraction": "< 0.20",
          "bound_fraction_pca": ">= 0.50",
          "seed_recall_vs_exact_pca": ">= _recall_floor_"
        },
        "route": { "basis": "pca_corpus", "k1_fraction": 0.05 }
      },
      { "fallback": { "basis": "random", "k1_fraction": 0.20 } }
    ]
  }
}
